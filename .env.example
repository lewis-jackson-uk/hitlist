# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorised redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32+ random characters, used to encrypt the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Without it, HitList uses rule-based urgency scoring and template drafts.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional. Comma-separated emails or domains that always rank as key contacts.
# Example: zoe@example.com,robotmascot.com
KEY_CONTACTS=

# Optional: Slack. Create an app at https://api.slack.com/apps in your own workspace (see README).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires https, so use your deployed URL
SLACK_REDIRECT_URI=https://your-app.vercel.app/api/slack/callback
